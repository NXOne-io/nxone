  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9",
    "wrangler": "^4.147.0"
  }
