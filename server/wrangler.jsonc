{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nxone-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nxone",
      // replace with the id printed by: npx wrangler d1 create nxone
      "database_id": "local-development",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      // replace with the id printed by: npx wrangler kv namespace create SESSIONS
      "id": "local-development"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://nxone.io",
    "EMAIL_PROVIDER": "console"
  }
}
